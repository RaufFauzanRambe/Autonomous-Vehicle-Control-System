# =============================================================================
#  sdkconfig  —  Autonomous Vehicle Control System / ESP32 platform
# =============================================================================
#  This is an ESP-IDF v5.x sdkconfig snippet. It is merged into the full
#  sdkconfig generated by `idf.py menuconfig` via the `SDKCONFIG_DEFAULTS`
#  mechanism. To use it manually, copy the relevant lines into your project's
#  sdkconfig.defaults or run `idf.py menuconfig` and apply the values shown.
#
#  Tested with:
#    - ESP-IDF v5.2.x
#    - Targets: esp32, esp32s3, esp32c3
#
#  Author: AVC team   |  License: MIT   |  Date: 2024
# =============================================================================

# -----------------------------------------------------------------------------
#  Global / build
# -----------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_IDF_FIRMWARE_CHIP_ID=0x0009
CONFIG_SDK_TOOLPREFIX="xtensa-esp32s3-elf-"
CONFIG_SDK_PYTHON="python"
CONFIG_APP_BUILD_TYPE_APP_2NDBOOTLOADER=y
CONFIG_APP_ROLLBACK_ENABLE=y                  # Critical for OTA rollback
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_9V=y
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_TIME_MS=9000
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y  # App manages its own watchdog

# -----------------------------------------------------------------------------
#  Serial flasher
# -----------------------------------------------------------------------------
CONFIG_ESPTOOLPY_BAUD=1500000
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_AFTER_RESET=y
CONFIG_ESPTOOLPY_BEFORE_RESET=y

# -----------------------------------------------------------------------------
#  Partition table — custom OTA scheme (factory + ota_0 + ota_1 + nvs)
# -----------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions_s3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/partitions_s3.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# -----------------------------------------------------------------------------
#  CPU / clock
# -----------------------------------------------------------------------------
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_DEFAULT_CPU_FREQ=240
CONFIG_ESP32S3_RTC_CLK_SRC_INT_RC=y
CONFIG_ESP32S3_TIME_SYSCALL_USE_RTC_FRC1=y

# -----------------------------------------------------------------------------
#  FreeRTOS
# -----------------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000                       # 1 kHz tick — required for our 100 Hz sensor task
CONFIG_FREERTOS_TICK_RATE=1000
CONFIG_FREERTOS_UNICORE=n                     # Use both cores on S3
CONFIG_FREERTOS_NUM_THREAD_LOCAL_STORAGE_POINTERS=4
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_CHECK_STACKOVERWRITE_CANARY=y
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=4
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1536
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_ENABLE_TASK_SNAPSHOT=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y            # Tickless idle for low power
CONFIG_FREERTOS_TICKLESS_IDLE_TIME=-1

# -----------------------------------------------------------------------------
#  Task watchdog (TWDT)
# -----------------------------------------------------------------------------
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=8
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_TASK_WDT_PANIC=y                    # Reset on watchdog trigger
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300

# -----------------------------------------------------------------------------
#  WiFi — Station mode
# -----------------------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA=y
CONFIG_ESP_WIFI_AP=n
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_BEACON_MAX_LEN=752
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_WAPI_PSK=y
CONFIG_ESP_WIFI_SLP_DEFAULT_MIN_ACTIVE_TIME=50
CONFIG_ESP_WIFI_SLP_DEFAULT_MAX_ACTIVE_TIME=10
CONFIG_ESP_WIFI_SLP_DEFAULT_MIN_BCN_TIMEOUT=3

# -----------------------------------------------------------------------------
#  Bluetooth (BLE)
# -----------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y                    # NimBLE stack — lower RAM than Bluedroid
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_DEBUG=n
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# -----------------------------------------------------------------------------
#  MQTT (using esp-mqtt via components; PubSubClient used in Arduino mode)
# -----------------------------------------------------------------------------
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y

# -----------------------------------------------------------------------------
#  lwIP
# -----------------------------------------------------------------------------
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
CONFIG_LWIP_TCPIP_TASK_AFFINITY_NO_AFFINITY=y
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=6
CONFIG_LWIP_TCP_QUEUE_OOSEQ=y
CONFIG_LWIP_TCP_OVERSIZE_MSS=y
CONFIG_LWIP_TCP_TSOPT=y
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_KEEPALIVE=y
CONFIG_LWIP_TCP_KEEP_CONNECTION_WHEN_IP_CHANGES=n
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_SO_LINGER=n
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_REUSE_RXTOALL=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_DHCP_OPTIONS_NTP_SERVER=y
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_MULTICAST=y
CONFIG_LWIP_DNS=y
CONFIG_LWIP_ESP_GRATUITOUS_ARP=y
CONFIG_LWIP_AUTOIP=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_NETIF_HOSTNAME=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y

# -----------------------------------------------------------------------------
#  mDNS
# -----------------------------------------------------------------------------
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_MDNS_TASK_PRIORITY=1
CONFIG_MDNS_TASK_STACK_SIZE=4096
CONFIG_MDNS_TASK_AFFINITY_NO_AFFINITY=y
CONFIG_MDNS_SERVICE_ADD_TIMEOUT_MS=2000

# -----------------------------------------------------------------------------
#  HTTP Client (for OTA)
# -----------------------------------------------------------------------------
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y              # Allow insecure OTA for development
CONFIG_ESP_HTTPS_OTA_DECRYPT_CB=n
CONFIG_ESP_HTTPS_DECRYPT_CB=n
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_ESP_HTTPS_CLIENT_ENABLE_HTTP2=n

# -----------------------------------------------------------------------------
#  NVS (non-volatile storage)
# -----------------------------------------------------------------------------
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_ASSERT_ERROR_CHECK=y
CONFIG_NVS_LEGACY_DUMMY_BYTES=y
CONFIG_NVS_NOASSERT=n

# -----------------------------------------------------------------------------
#  SPI flash / partition support
# -----------------------------------------------------------------------------
CONFIG_SPI_FLASH_ENABLE_ENCRYPTED_READ_WRITE=y
CONFIG_SPI_FLASH_USE_LEGACY_IMPL=n
CONFIG_SPI_FLASH_WARN_SETTING_ZERO_TO_NONEMPTY_ERASED_REGION=y
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=20
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=1
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=8192
CONFIG_SPI_FLASH_ERASE_CHUNK_WINDOWS_SIZE=4
CONFIG_SPI_FLASH_SIZE=8
CONFIG_SPI_FLASH_ROM_DRIVER_PATCH=y

# -----------------------------------------------------------------------------
#  PSRAM (ESP32-S3 — OPI / octal)
# -----------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCTAL=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_CACHE_WORKAROUND=y

# -----------------------------------------------------------------------------
#  Logging
# -----------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL=5
CONFIG_LOG_COLORS=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# -----------------------------------------------------------------------------
#  Application / security
# -----------------------------------------------------------------------------
CONFIG_APP_BUILD_TYPE_APP_2NDBOOTLOADER=y
CONFIG_SECURE_BOOT=n                           # Enable in production
CONFIG_SECURE_FLASH_ENC_ENABLED=n              # Enable in production
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_COMPILER_STACK_CHECK=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_DISABLE_GCC8_WARNINGS=y
CONFIG_COMPILER_DUMP_RTL_FILES=n
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y

# End of sdkconfig
